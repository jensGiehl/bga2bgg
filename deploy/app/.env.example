# Copy to ".env" (same folder), one per app. docker compose reads it automatically.

# Full image reference published by CI (GitHub Container Registry).
APP_IMAGE=ghcr.io/jensgiehl/bga2bgg:latest

# App name = the subdomain label AND the Traefik router name. Must be unique
# per app on this host. The final URL is APP_NAME.BASE_DOMAIN.
APP_NAME=bga2bgg

# Shared base domain. A wildcard DNS record "*.BASE_DOMAIN" must point at the
# server's public IP so every app resolves without a per-app DNS entry.
BASE_DOMAIN=example.com
